VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# NEVER put the service_role key in a VITE_ variable — it bypasses RLS and
# gets bundled into client-side JS, exposing full database access to anyone
# who opens dev tools. Service-role usage belongs only in a trusted server
# context (e.g. a Supabase Edge Function), never in this Vite app.
